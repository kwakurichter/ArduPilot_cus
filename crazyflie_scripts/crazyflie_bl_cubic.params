# Calibration settings for stock Crazyflie 2.1 Brushless motors, props and ESCs.
# Review crazyflie_bl_cubic.md and bench-test before flight. Reboot after loading.
# Set MOT_THST_HOVER from actual flying mass: mass_kg * 9.80665 / 0.8.
MOT_THST_MODEL 1
MOT_PWM_TYPE 5
MOT_BAT_VOLT_MAX 4.2
MOT_BAT_VOLT_MIN 3.3
# Keep running motors within the measured part of the cubic at 3.3 V.
MOT_SPIN_MIN 0.25
MOT_SPIN_MAX 0.95
