# Basic Crazyflie 2.1 BL settings

# Tuning settings
ACRO_YAW_P,4
ATC_ACCEL_P_MAX,162000
ATC_ACCEL_R_MAX,162000
ATC_ACCEL_Y_MAX,54000
ATC_ANG_PIT_P,6
ATC_ANG_RLL_P,6
ATC_ANG_YAW_P,6
ATC_RAT_PIT_D,0.002
ATC_RAT_PIT_FLTD,70
ATC_RAT_PIT_FLTT,70
ATC_RAT_PIT_I,0.058
ATC_RAT_PIT_P,0.040
ATC_RAT_RLL_D,0.002
ATC_RAT_RLL_FLTD,70
ATC_RAT_RLL_FLTT,70
ATC_RAT_RLL_I,0.058
ATC_RAT_RLL_P,0.040
ATC_RAT_YAW_FLTE,2
ATC_RAT_YAW_FLTT,81
ATC_RAT_YAW_I,0.04
ATC_RAT_YAW_P,0.4

# Gyro Filtering settings
INS_GYRO_FILTER,120
INS_ACCEL_FILTER,10
INS_GYRO_RATE,1     # 2kHz
INS_HNTCH_ENABLE,1  # Notch Filter
INS_HNTCH_ATT,40
INS_HNTCH_BW,90
INS_HNTCH_FM_RAT,1
INS_HNTCH_FREQ,270
INS_HNTCH_HMNCS,3
INS_HNTCH_MODE,3
INS_HNTCH_OPTS,6
INS_HNTCH_REF,1
FFT_ENABLE,1        # Dynamic FFT
FFT_ATT_REF,15
FFT_BW_HOVER,74
FFT_FREQ_HOVER,204
FFT_MAXHZ,495
FFT_MINHZ,80
FFT_OPTIONS,1
FFT_WINDOW_OLAP,0.5
FFT_WINDOW_SIZE,256

# X-frame
FRAME_CLASS,1

# Brushless PWM Motors
MOT_PWM_TYPE,5      #DShot300
SERVO_BLH_AUTO,1    #BLHeli_S
SERVO_BLH_MASK,15   #BLHeli_S
SERVO_BLH_DEBUG,0   #BLHeli_S
SERVO_BLH_BDMASK,15  #BLHeli_S
SERVO_DSHOT_ESC,2   #BLHeli_S
SERVO1_FUNCTION,33
SERVO2_FUNCTION,36
SERVO3_FUNCTION,34
SERVO4_FUNCTION,35

# Thrust Compensation (Advanced)
MOT_OPTIONS,1       # Raw voltage
MOT_THST_EXPO,0.450
MOT_THST_HOVER,0.300

# NRF51 Radio (Advanced)
SERIAL2_PROTOCOL,2
SERIAL2_BAUD,1000
SERIAL3_PROTOCOL,2

# 1s lipo (Advanced)
MOT_BAT_VOLT_MAX,4.2
MOT_BAT_VOLT_MIN,3.3
BATT_MONITOR,29     # NRF Battery Monitor

# Position Controllers (Advanced)
PSC_ACCZ_D,0.040
PSC_ACCZ_I,1.000
PSC_ACCZ_P,0.500
PSC_POSXY_P,1.500
PSC_POSZ_P,1.400
PSC_VELXY_D,0.300
PSC_VELXY_I,0.500
PSC_VELXY_P,2.500
PSC_VELZ_D,0.000
PSC_VELZ_I,1.000
PSC_VELZ_P,3.000