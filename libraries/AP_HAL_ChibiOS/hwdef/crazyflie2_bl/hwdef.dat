# hw definition file for processing by chibios_pins.py
# for crazyflie2.1 BL hardware (see bitcraze.io)

# MCU class and specific type
MCU STM32F4xx STM32F405xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID TARGET_HW_CRAZYFLIEBL

# crystal frequency
OSCILLATOR_HZ 8000000

define STM32_ST_USE_TIMER 5

FLASH_SIZE_KB 1024


# use USB for stdout
#STDOUT_SERIAL SD3
#STDOUT_BAUDRATE 57600

# usart2
PA2 USART2_TX USART2 NODMA # E_TX2
PA3 USART2_RX USART2 NODMA # E_RX2

# external SPI on SPI1
PA5 SPI1_SCK SPI1  # E_SCK
PA6 SPI1_MISO SPI1 # E_MISO
PA7 SPI1_MOSI SPI1 # E_MOSI

# I2C3 is for IMU
PA8 I2C3_SCL I2C3
PC9 I2C3_SDA I2C3

# USB port
PA10 USB_ID INPUT
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# stlink/jtag
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Brushless Motor setup
PA1   TIM2_CH2  TIM2  PWM(1)  OD  SPEED_VERYHIGH PULLUP BIDIR   # M1
PB11  TIM2_CH4  TIM2  PWM(2)  OD  SPEED_VERYHIGH PULLUP         # M2 - BDSHOT non-functional currently. see (https://github.com/bitcraze/crazyflie-firmware/pull/1556)
PA15  TIM2_CH1  TIM2  PWM(3)  OD  SPEED_VERYHIGH PULLUP BIDIR   # M3
PB10  TIM2_CH3  TIM2  PWM(4)  OD  SPEED_VERYHIGH PULLUP BIDIR   # M4

# So CH3 can share DMA with TIM2_UP
DMA_PRIORITY TIM2*

PC13 MPU_INT INPUT
PC14 MPU_FSYNC OUTPUT LOW


PC15 BRUSHLESS_RESET OUTPUT LOW OD GPIO(95)  SPEED_VERYHIGH     # Brushless ESC Reset Pin

# LEDs
PD2 LED_BLUE OUTPUT HIGH
PC0 LED_RED_L OUTPUT HIGH
PC1 LED_GREEN_L OUTPUT HIGH
PC2 LED_GREEN_R OUTPUT HIGH
PC3 LED_RED_R OUTPUT HIGH

# misc pins, unused
#PH0 OSC_IN
#PH1 OSC_OUT
#PB2 BOOT1
# PB3 STM_SWO

# CS pins for external SPI devices
PC12 E_CS0 CS
PB4 E_CS1 CS
PB5 E_CS2 CS
PB8 E_CS3 CS

# external I2C on I2C1
PB6 I2C1_SCL I2C1 # E_SCL
PB7 I2C1_SDA I2C1 # E_SCL

# radio setup 
PA4 NRF_FLOW_CTRL INPUT GPIO(62) # goes low when we can write to uart
#PB13 NRF_SWCLK
#PB15 NRF_SWIO
PC6 USART6_TX USART6 # NRF_RT
PC7 USART6_RX USART6 # NRF_RX

# USART3 for telemetry
PC10 USART3_TX USART3 # E_TX1
PC11 USART3_RX USART3 # E_RX1

# setup I2C order
I2C_ORDER I2C3 I2C1

# we need I2C clock at 400kHz for IMU
define HAL_I2C_MAX_CLOCK 400000

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART3 USART6 USART2

# SERIAL2 is the nRF51822 radio, driven by AP_Syslink which owns the port
# outright and registers its own virtual MAVLink port. Nothing else may
# claim it.
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_None

define HAL_STORAGE_SIZE 15360
STORAGE_FLASH_PAGE 1

# reserve 32k for bootloader and 32k for flash storage
FLASH_RESERVE_START_KB 64

# SPI Device table
SPIDEV optflow     SPI1 DEVID0 E_CS1 MODE3 2*MHZ 2*MHZ  # Add FlowDeck Support
SPIDEV sdcard      SPI1 DEVID1 E_CS0 MODE0 400*KHZ 25*MHZ  # Add SD card deck support

# One IMU for Crazyflie 2.1 - I2C
IMU BMI088 I2C:0:0x18 I2C:0:0x69 ROTATION_ROLL_180

# One IMU for Crazyflie 2.0 - I2C
IMU Invensense I2C:0:0x69 ROTATION_YAW_180

# One baro for Crazyflie 2.1
BARO BMP388 I2C:0:0x77

# One bare for Crazyflie 2.0
BARO LPS2XH:probe_InvensenseIMU I2C:0:0x5D 0x69

# no built-in compass, but probe the i2c bus for all possible
# external compass types
define ALLOW_ARM_NO_COMPASS
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

define MAG_BOARD_ORIENTATION ROTATION_YAW_180

# no ADC pins
define HAL_USE_ADC FALSE

# SPI Enable
define HAL_USE_SPI TRUE     # Necessary?

# Enable FAT filesystem support
define HAL_OS_FATFS_IO 1

include ../include/minimize_features.inc

define AP_RANGEFINDER_ENABLED 1       #FlowDeck Support
define AP_OPTICALFLOW_ENABLED 1       #FlowDeck Support
define AP_BATTERY_SCRIPTING_ENABLED 1 #Battery Monitor Support
# define AP_SCRIPTING_ENABLED 1         #Lua Script Support
# define SCRIPTING_STACK_SIZE (12*1024) #Default is 17kB. 12 is sufficient for simple state machines

# undef HAL_GYROFFT_ENABLED             #Notch Filtering Support
# define HAL_GYROFFT_ENABLED 1

define HAL_CF21                        #Crazyflie advanced features support
define HAL_CF21_BRUSHLESS              #BDSHOT support

# ---------------------------------------------------------------------------
# Flash diet to make room for Lua scripting on the 1MB F405.
# Comment a line back out to get the feature back.
# ---------------------------------------------------------------------------

# Hardware the Crazyflie has no connector for (~46 KB)
define AP_FRSKY_TELEM_ENABLED 0
define AP_CAMERA_ENABLED 0
define AC_PRECLAND_ENABLED 0
define HAL_RALLY_ENABLED 0
define AP_RSSI_ENABLED 0
define HAL_PARACHUTE_ENABLED 0
define AP_VIDEOTX_ENABLED 0
define AP_RELAY_ENABLED 0
define AP_SERVORELAYEVENTS_ENABLED 0
define AP_ICENGINE_ENABLED 0
define HAL_EFI_ENABLED 0
undef AP_LANDINGGEAR_ENABLED
define AP_LANDINGGEAR_ENABLED 0

# Terrain database needs SD card map tiles (~5.5 KB)
define AP_TERRAIN_AVAILABLE 0

# buzzer (~2.8 KB)
define AP_NOTIFY_TONEALARM_ENABLED 0

# No airspeed sensor. minimize_common.inc force-enables the individual
# backends, so each has to be turned off or it fails to compile against
# a base class that no longer exists (~8.5 KB)
define AP_AIRSPEED_ENABLED 0
undef AP_AIRSPEED_MS4525_ENABLED
undef AP_AIRSPEED_ASP5033_ENABLED
undef AP_AIRSPEED_ANALOG_ENABLED
undef AP_AIRSPEED_MS5525_ENABLED
undef AP_AIRSPEED_SDP3X_ENABLED
undef AP_AIRSPEED_NMEA_ENABLED
undef AP_AIRSPEED_DRONECAN_ENABLED
define AP_AIRSPEED_MS4525_ENABLED 0
define AP_AIRSPEED_ASP5033_ENABLED 0
define AP_AIRSPEED_ANALOG_ENABLED 0
define AP_AIRSPEED_MS5525_ENABLED 0
define AP_AIRSPEED_SDP3X_ENABLED 0
define AP_AIRSPEED_NMEA_ENABLED 0
define AP_AIRSPEED_DRONECAN_ENABLED 0

# No proximity sensor (~6.9 KB)
define AP_AVOIDANCE_ENABLED 0
define HAL_PROXIMITY_ENABLED 0

# Sensor backends cut down to what a Crazyflie deck actually carries
# rangefinder ~18.6 KB, opticalflow ~2.7 KB
define AP_RANGEFINDER_BACKEND_DEFAULT_ENABLED 0
define AP_RANGEFINDER_VL53L1X_ENABLED 1

define AP_OPTICALFLOW_BACKEND_DEFAULT_ENABLED 0
define AP_OPTICALFLOW_FLOWDECK_ENABLED 1

# Drops probing for every external I2C magnetometer (~17 KB)
# define AP_COMPASS_QMC5883L_ENABLED 1
define AP_COMPASS_I2C_BACKEND_DEFAULT_ENABLED 0

# No GPS receiver indoors; the AP_GPS front end stays for EKF plumbing (~9.3 KB)
undef AP_GPS_UBLOX_ENABLED
define AP_GPS_UBLOX_ENABLED 0

# define HAL_VISUALODOM_ENABLED 1        #OptiTrack Support
# define EK3_FEATURE_EXTERNAL_NAV 1      #OptiTrack Support
undef MODE_GUIDED_NOGPS_ENABLED        #AI Deck support
define MODE_GUIDED_NOGPS_ENABLED 1

# This is a board that's not really intended for anything other than copter
AUTOBUILD_TARGETS Copter