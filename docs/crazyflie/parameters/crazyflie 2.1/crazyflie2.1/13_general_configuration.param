INS_POS1_Y,0  # Make sure to calibrate gyroscope upon setup.
INS_POS2_X,0  # Make sure to calibrate gyroscope upon setup.
INS_POS2_Y,0  # Make sure to calibrate gyroscope upon setup.
SCHED_LOOP_RATE,400
